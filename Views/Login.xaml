<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="mvasquezExamenParcial.Views.Login"
             Title="Login">
    <VerticalStackLayout Spacing="20">
        <Label Text="Login" FontSize="20" TextColor="Red"/>
        <Image Source="uisrael_400x400.jpg" HeightRequest="200" WidthRequest="400"/>
        <Grid ColumnDefinitions="auto,*" RowDefinitions="auto,*">
            <Label Grid.Column="0" Grid.Row="0" Text="Usuario"/>
            <Label Grid.Column="0" Grid.Row="1" Text="Constraseña"/>
            <Entry Grid.Column="1" Grid.Row="0" 
                Placeholder="Usuario" x:Name="usernameInput"/>
            <Entry Grid.Column="1" Grid.Row="1" 
                Placeholder="Contraseña" x:Name="passwordInput"/>
        </Grid>
        <Button Grid.Column="0" Text="Inicio de sesión" x:Name="loginButton" Pressed="loginButton_Pressed"/>
    </VerticalStackLayout>
</ContentPage>