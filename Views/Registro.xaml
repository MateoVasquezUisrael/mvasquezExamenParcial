<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="mvasquezExamenParcial.Views.Registro"
             Title="Registro">
    <ScrollView>
    <VerticalStackLayout Padding="20" Spacing="20">
        <Label x:Name="LabelSaludo" HorizontalOptions="End"/>
        <Label Text="REGISTRO"/>

        <Grid 
              RowSpacing="20"
              ColumnSpacing="20"
              ColumnDefinitions="auto,*"
              RowDefinitions="auto,auto,auto,auto,auto">
            <Label Text="Fecha:"        Grid.Column="0" Grid.Row="0"/>
            <Label Text="Pais:"         Grid.Column="0" Grid.Row="1"/>
            <Label Text="Ciudad:"       Grid.Column="0" Grid.Row="2"/>
            <Label Text="Monto:"        Grid.Column="0" Grid.Row="3"/>
            <Label Text="Pago Mensual:" Grid.Column="0" Grid.Row="4"/>

            <DatePicker Date="05/06/2026" Grid.Column="1" Grid.Row="0" x:Name="datePicker"/>

            <Picker Grid.Column="1" Grid.Row="1" x:Name="countryPicker">
                <Picker.Items>
                    <x:String>Ecuador</x:String>
                    <x:String>Colombia</x:String>
                    <x:String>Venezuela</x:String>
                </Picker.Items>
            </Picker>

            <Picker Grid.Column="1" Grid.Row="2" x:Name="cityPicker">
                <Picker.Items>
                    <x:String>Quito</x:String>
                    <x:String>Guayaquil</x:String>
                    <x:String>Bogotá</x:String>
                    <x:String>Maracaibo</x:String>
                </Picker.Items>
            </Picker>

            <Entry Keyboard="Numeric"
                   Grid.Column="1" Grid.Row="3"
                   x:Name="originalAmountEntry"/>

            <Entry IsEnabled="False"
                   Grid.Column="1" Grid.Row="4"
                   x:Name="monthlyPayEntry"
                   Placeholder="Valor"/>
        </Grid>
        <Button Text="Calcular monto"
                x:Name="calcButton"
                Pressed="calcButton_Pressed"/>

        <Grid ColumnSpacing="20" ColumnDefinitions="250,250,*"
              RowDefinitions="auto,auto">
            <Label Text="Nombre:"   Grid.Column="0" Grid.Row="0"/>
            <Label Text="Apellido:" Grid.Column="1" Grid.Row="0"/>
            <Label Text="Edad:"     Grid.Column="2" Grid.Row="0"/>

            <Entry Placeholder="Nombre" Grid.Column="0" Grid.Row="1" x:Name="nameInput"/>
            <Entry Placeholder="Apellido" Grid.Column="1" Grid.Row="1" x:Name="lastnameInput"/>
            <Entry Placeholder="Edad" Grid.Column="2" Grid.Row="1" x:Name="ageInput"/>
        </Grid>

        <Button Text="Ver Resumen"
                x:Name="resumeButton"
                Pressed="resumeButton_Pressed"/>
    </VerticalStackLayout>
    </ScrollView>
</ContentPage>